# Python runtime files
__pycache__/
*.py[cod]

# Windows shortcut files
*.lnk

# User-created layout presets; keep the checked-in examples
custom-layouts/*.json
!custom-layouts/Main.json
!custom-layouts/Mixed Example.json

# Layout UI runtime state (last opened preset, slot high-water mark), error log,
# and temp files left by an interrupted atomic write
.layout-ui-state.json
layout_ui_error.log
.*.json.*.tmp

# Live model lists cached by model_catalog.py
.model-cache.json

# PyInstaller build output
build/
LayoutUI.exe
